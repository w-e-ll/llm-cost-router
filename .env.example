# Setup generates both database passwords. Never commit .env.
OPENAI_API_KEY=
POSTGRES_ADMIN_PASSWORD=CHANGE_ME
POSTGRES_APP_PASSWORD=CHANGE_ME
POSTGRES_PORT=5434
API_PORT=8000
UI_PORT=8501
LOG_LEVEL=INFO
LOG_FORMAT=text
# Optional host/PyCharm access; Compose sets its own internal URLs:
# DATABASE_URL=postgresql+psycopg://llm_router:APP_PASSWORD@127.0.0.1:5434/llm_cost_router
# TEST_DATABASE_URL=postgresql+psycopg://llm_router:APP_PASSWORD@127.0.0.1:5434/llm_cost_router_test

